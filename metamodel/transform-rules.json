  "ocr": {
    "note": "Text read from pictures (macOS Vision or Tesseract, on the machine — no network). Each label becomes a candidate only when a name already found, a label word or the section decides its type; never above low; lines (arrows) are not read from pictures. Labels starting with a small letter are skipped: they are almost always captions on lines (\"clearing file\").",
    "min_confidence": 0.5,
    "min_chars": 3,
    "max_chars": 60,
    "max_words": 6,
    "ignore": [
      "legend",
      "key",
      "title",
      "version",
      "draft",
      "confidential",
      "page"
    ],
    "skip_lowercase": true
  }
