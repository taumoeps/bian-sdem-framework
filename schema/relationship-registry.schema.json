{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDEM Architecture Relationship Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mappings"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "metamodel_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "description": "The Bank Architecture Profile the document was written under (optional; high-level §4; gap G-05; profiles are not built yet)"
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "use_case": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "source",
        "relationship",
        "target",
        "status",
        "evidence",
        "rationale",
        "baseline_id"
      ],
      "properties": {
        "mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/entity"
        },
        "target": {
          "$ref": "#/$defs/entity"
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "perspective": {
          "enum": [
            "process",
            "information",
            "architecture"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "validated",
            "needs_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "baseline_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bian_release": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "string",
          "minLength": 1
        },
        "valid_to": {
          "type": "string",
          "minLength": 1
        },
        "previous_mapping_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^(A[1-4]|L[0-3])\\.[A-Za-z]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "description": "Which level model or tool holds the instance (optional; high-level §4, §14 decision 4; gap G-05)"
        },
        "source_entity_id": {
          "type": "string",
          "minLength": 1,
          "description": "The instance's native id in its source tool, if it differs from id (optional; high-level §4; gap G-05)"
        }
      }
    }
  }
}
