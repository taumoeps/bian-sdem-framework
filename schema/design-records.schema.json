{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDEM design records and gap records",
  "description": "Kept beside an estate's architecture datasets, in <estate>/designs/design-records.json: one design record per source page or file of an imported design, and one gap record per item that did not fit an architecture entity (docs/sdem-load-design.md §4a). Information, not architecture: never read by the rules engine or impact analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["records_version", "documents", "gaps"],
  "properties": {
    "records_version": {"enum": ["1.0"]},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "file", "entities", "loads"],
      "properties": {
        "id": {"type": "string", "pattern": "^DOC-[A-Z0-9-]+$"},
        "kind": {"enum": ["page", "diagram file", "picture file", "file"]},
        "page_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "space": {"type": "string"},
        "url": {"description": "the page's address, or null"},
        "file": {"type": "string", "minLength": 1},
        "modified": {"description": "the page's last-modified date (YYYY-MM-DD), or null"},
        "breadcrumb": {"type": "array", "items": {"type": "string"}},
        "facts": {"type": "object", "additionalProperties": {"type": "string"}},
        "coverage": {"description": "the page's coverage from the transform (captured, skipped, not captured, percent), or null"},
        "entities": {"type": "array", "items": {"type": "string"}, "description": "ids of the entities loaded from this page"},
        "loads": {"type": "array", "items": {"type": "string", "pattern": "^LOAD-[0-9]+$"}, "minItems": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "document", "category", "kind", "where", "reason", "about", "status", "first_load"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[A-Z0-9]+$"},
        "document": {"type": "string", "pattern": "^DOC-[A-Z0-9-]+$"},
        "category": {"enum": ["no entity type", "no rule matched", "column not mapped", "text not read", "needs a person",
                               "line without both ends", "diagram kind not read", "file not read", "rejected at load"]},
        "kind": {"type": "string"},
        "where": {"type": "string"},
        "text": {"type": "string"},
        "reason": {"type": "string"},
        "about": {"type": "array", "items": {"type": "string"}, "description": "ids of the entities the gap is about"},
        "status": {"enum": ["open", "resolved", "accepted"], "description": "open until a person deals with it; resolved (now in the data) or accepted (left as it is, on purpose)"},
        "first_load": {"type": "string", "pattern": "^LOAD-[0-9]+$"},
        "note": {"type": "string"},
        "history": {"type": "array", "description": "every status change, by a person (sdem designs resolve | accept | reopen)", "items": {
          "type": "object", "additionalProperties": false, "required": ["status", "at", "person", "note"],
          "properties": {"status": {"enum": ["open", "resolved", "accepted"]}, "at": {"type": "string", "minLength": 1},
                         "person": {"type": "string", "minLength": 1}, "note": {"type": "string"}}}}
      }
    }
  }
}
