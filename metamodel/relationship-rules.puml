@startuml relationship-rules
left to right direction
skinparam rectangle {
  BackgroundColor White
  BorderColor #424242
}
skinparam package {
  BackgroundColor #F5F5F5
  BorderColor #9E9E9E
}
skinparam ArrowFontSize 9
skinparam ArrowThickness 1
title New mappings (plan) — 22 cross-level connections by rule decision; every one validated by the use-case suite

package "A1 Business Architecture" as A1 {
  rectangle "A1.BusinessCapability\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businesscapability #EEEEEE
  rectangle "A1.ValueStream\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_valuestream #EEEEEE
  rectangle "A1.ValueStreamStage\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_valuestreamstage #EEEEEE
  rectangle "A1.BusinessProcess\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessprocess #EEEEEE
  rectangle "A1.BusinessActivity\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessactivity #EEEEEE
  rectangle "A1.BusinessService\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessservice #EEEEEE
  rectangle "A1.BusinessActor\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessactor #EEEEEE
  rectangle "A1.BusinessRole\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessrole #EEEEEE
  rectangle "A1.BusinessObject\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessobject #EEEEEE
  rectangle "A1.BusinessRequirement\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessrequirement #EEEEEE
  rectangle "A1.BusinessEvent\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessevent #EEEEEE
  rectangle "A1.Product\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_product #EEEEEE
  rectangle "A1.BusinessInterface\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a1_businessinterface #EEEEEE
}

package "A2 Service Domain Architecture" as A2 {
}

package "A3 Application Architecture" as A3 {
  rectangle "A3.ApplicationComponent" as a3_applicationcomponent
  rectangle "A3.ApplicationService" as a3_applicationservice
  rectangle "A3.ApplicationInterface" as a3_applicationinterface
  rectangle "A3.ApplicationFunction" as a3_applicationfunction
  rectangle "A3.APIOperation" as a3_apioperation
  rectangle "A3.DataEntity" as a3_dataentity
  rectangle "A3.Event" as a3_event
  rectangle "A3.SolutionBuildingBlock" as a3_solutionbuildingblock
  rectangle "A3.DataAttribute\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a3_dataattribute #EEEEEE
  rectangle "A3.DataDomain\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a3_datadomain #EEEEEE
}

package "A4 Technology Architecture" as A4 {
  rectangle "A4.InfrastructureComponent\n(abstract)" as a4_infrastructurecomponent
  rectangle "A4.Deployment" as a4_deployment
  rectangle "A4.DeploymentEnvironment" as a4_deploymentenvironment
  rectangle "A4.Node" as a4_node
  rectangle "A4.Device" as a4_device
  rectangle "A4.SystemSoftware" as a4_systemsoftware
  rectangle "A4.TechnologyService" as a4_technologyservice
  rectangle "A4.TechnologyInterface" as a4_technologyinterface
  rectangle "A4.CommunicationNetwork" as a4_communicationnetwork
  rectangle "A4.NetworkZone\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a4_networkzone #EEEEEE
  rectangle "A4.Path" as a4_path
  rectangle "A4.Artifact" as a4_artifact
  rectangle "A4.Location\n<size:9><i>no cross-level mapping: no plan row</i></size>" as a4_location #EEEEEE
}

' --- catalogue rule (SDEM relationship type) (2)
a3_applicationcomponent -[#1565C0,bold]-> a4_deployment : S32 DEPLOYED_AS (step 1)
a3_applicationcomponent -[#1565C0,bold]-> a4_infrastructurecomponent : S33 step 1 high

' --- candidate rule (proposed for the relationship type catalogue) (0)

' --- conditional rule (fires on institution data) (5)
a3_applicationcomponent -[#EF6C00]-> a4_node : S34 step 1 low
a3_applicationcomponent -[#EF6C00]-> a4_artifact : S39 step 1 medium
a3_applicationservice -[#EF6C00]-> a4_technologyservice : S41 step 1 medium
a3_applicationfunction -[#EF6C00]-> a4_technologyservice : S45 step 1 medium
a3_dataentity -[#EF6C00]-> a4_artifact : S49 step 1 medium

' --- derived path (closure over other arrows, never proposed) (8)
a3_applicationcomponent -[#616161,dashed]-> a4_deploymentenvironment : S40 step 3 high
a3_applicationservice -[#616161,dashed]-> a4_technologyinterface : S42 step 3 low
a3_applicationfunction -[#616161,dashed]-> a4_systemsoftware : S46 step 3 low
a3_apioperation -[#616161,dashed]-> a4_deployment : S47 step 3 high
a3_apioperation -[#616161,dashed]-> a4_technologyinterface : S48 step 3 medium
a3_solutionbuildingblock -[#616161,dashed]-> a4_infrastructurecomponent : S52 step 3 medium
a3_solutionbuildingblock -[#616161,dashed]-> a4_deployment : S53 step 3 medium
a3_solutionbuildingblock -[#616161,dashed]-> a4_node : S54 step 3 low

' --- institution-only (reported from architecture dataset keys) (7)
a3_applicationcomponent -[#6A1B9A,dotted]-> a4_device : S35 step 1 low
a3_applicationcomponent -[#6A1B9A,dotted]-> a4_communicationnetwork : S37 step 1 low
a3_applicationcomponent -[#6A1B9A,dotted]-> a4_path : S38 step 1 low
a3_applicationinterface -[#6A1B9A,dotted]-> a4_technologyinterface : S43 step 1 low
a3_applicationinterface -[#6A1B9A,dotted]-> a4_technologyservice : S44 step 3 low
a3_dataentity -[#6A1B9A,dotted]-> a4_systemsoftware : S50 step 1 medium
a3_event -[#6A1B9A,dotted]-> a4_technologyservice : S51 step 1 low

legend right
  <color:#1565C0>Bold</color>: catalogue rule (SDEM relationship type) (2)
  <color:#2E7D32>Solid</color>: candidate rule (proposed for the relationship type catalogue) (0)
  <color:#EF6C00>Solid</color>: conditional rule (fires on institution data) (5)
  <color:#616161>Dashed</color>: derived path (closure over other arrows, never proposed) (8)
  <color:#6A1B9A>Dotted</color>: institution-only (reported from architecture dataset keys) (7)
  Grey entity: no cross-level mapping by decision (artefacts are never endpoints; actors and roles are organisation, not mappings)
  Not drawn: S36 subsumed; B02–B15 inside A2 are on official-mappings.puml
endlegend
@enduml
