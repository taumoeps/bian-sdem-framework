{
  "metamodel_version": "0.4.0",
  "note": "Within-level relationships are held by each level model, never by SDMM mapping documents. This catalogue defines the kinds a conforming level model may use; the full ArchiMate relationship table is not reproduced here. 0.5.14: artefact rows added (Wireframe → ServiceDomain B14, SemanticAPI → ServiceDomain B15, BOMModel → BusinessObject) so artefacts can be carried in an A2 export as documents attached to their domain or objects; artefacts remain non-endpoints for cross-level mappings.",
  "kinds": [
    {
      "kind": "composition",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "whole consists of part; part cannot exist independently"
    },
    {
      "kind": "aggregation",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "whole groups parts that can exist independently"
    },
    {
      "kind": "assignment",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "active structure performs behaviour, or artefact is deployed on node"
    },
    {
      "kind": "realization",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "element plays a critical role in creating or achieving another"
    },
    {
      "kind": "serving",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "element provides its functionality to another"
    },
    {
      "kind": "access",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "behaviour observes or acts upon a passive element"
    },
    {
      "kind": "flow",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "transfer from one element to another"
    },
    {
      "kind": "triggering",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "temporal or causal precedence"
    },
    {
      "kind": "specialization",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "element is a particular kind of another"
    },
    {
      "kind": "association",
      "source": "ArchiMate 3.2 ch. 5",
      "semantics": "unspecified relationship"
    }
  ],
