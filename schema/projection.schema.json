{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taumoeps/bian-sdem-framework/schema/projection.schema.json",
  "title": "SDEM projection package (Architecture Inference Design)",
  "description": "A projected design made by AID (docs/aid-spec.md AID-O01…O05): metadata, one projected dataset per projected layer, and the projected links. Never real architecture data (CTL-16); every element carries its provenance and is at most medium confidence (CTL-17).",
  "type": "object",
  "required": ["projection", "layers", "links"],
  "additionalProperties": false,
  "properties": {
    "projection": {"$ref": "#/$defs/metadata"},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"A1": {"$ref": "#/$defs/dataset"}, "A2": {"$ref": "#/$defs/dataset"}, "A3": {"$ref": "#/$defs/dataset"}, "A4": {"$ref": "#/$defs/dataset"}}
    },
    "links": {
      "type": "object", "required": ["links"], "additionalProperties": false,
      "properties": {"links": {"type": "array", "items": {"$ref": "#/$defs/link"}}}
    }
  },
  "$defs": {
    "provenance": {
      "description": "Why the element exists: the AID step, the rule and its published source, the records it was inferred from, the reasoning, and the inference confidence (never above medium, 0.6).",
      "type": "object",
      "required": ["step", "rule", "source_reference", "inferred_from", "reasoning", "confidence"],
      "additionalProperties": false,
      "properties": {
        "step": {"enum": ["F1", "F2", "F3", "R1", "R2", "R3", "M"]},
        "rule": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "inferred_from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reasoning": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 0.6}
      }
    },
    "record": {
      "type": "object",
      "required": ["id", "type", "version", "name", "projection"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "pattern": "^A[1-4]\\."},
        "version": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "projection": {"$ref": "#/$defs/provenance"}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["level", "model_id", "model_version", "metamodel_version", "source_system", "instances", "relationships"],
      "additionalProperties": false,
      "properties": {
        "level": {"enum": ["A1", "A2", "A3", "A4"]},
        "model_id": {"type": "string", "pattern": "-PROJECTION$"},
        "model_version": {"enum": ["projection"]},
        "metamodel_version": {"type": "string", "minLength": 1},
        "source_system": {"type": "string", "pattern": "^AID-PROJECTION"},
        "instances": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "relationships": {"type": "array", "items": {"type": "object", "required": ["source", "kind", "target"]}}
      }
    },
    "endpoint": {"type": "object", "required": ["id", "type", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "pattern": "^A[1-4]\\."}, "version": {"type": "string"}}},
    "link": {
      "type": "object",
      "required": ["mapping_id", "source", "relationship", "target", "status", "confidence", "rationale", "projection"],
      "additionalProperties": false,
      "properties": {
        "mapping_id": {"type": "string", "pattern": "^PRJ-L-"},
        "source": {"$ref": "#/$defs/endpoint"},
        "relationship": {"enum": ["USES_DOMAIN", "SUPPORTED_BY", "ALIGNED_TO", "REALIZED_BY", "IMPLEMENTED_BY", "MAPPED_TO", "DEPLOYED_AS", "DEPLOYED_ON"]},
        "target": {"$ref": "#/$defs/endpoint"},
        "status": {"enum": ["projected"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 0.6},
        "rationale": {"type": "string", "pattern": "^PROJECTED DESIGN, not a mapping"},
        "projection": {"$ref": "#/$defs/provenance"}
      }
    },
    "metadata": {
      "type": "object",
      "required": ["projection_id", "mode", "created_by", "created_at", "metamodel_version", "have", "catalogue", "inputs", "steps", "projection_ends", "summary", "links"],
      "additionalProperties": false,
      "properties": {
        "projection_id": {"type": "string", "pattern": "^PRJ-"},
        "mode": {"enum": ["forward", "reverse", "middle", "forward and reverse"]},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "metamodel_version": {"type": "string", "minLength": 1},
        "have": {"type": "array", "minItems": 1, "items": {"enum": ["A1", "A2", "A3", "A4"]}},
        "catalogue": {"type": "object", "required": ["model_id", "sha256"]},
        "inputs": {"type": "object"},
        "steps": {"type": "array"},
        "projection_ends": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "object"},
        "links": {"type": "integer", "minimum": 0}
      }
    }
  }
}
