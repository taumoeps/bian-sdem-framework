  a2_servicedomain -[#9E9E9E,dotted]-> a2_functionalpattern : association
  a2_servicedomain -[#9E9E9E,dotted]-> a2_assettype : association
  a2_serviceoperation -[#9E9E9E,dotted]-> a2_behaviorqualifier : association
  a2_businessscenario -[#1565C0,dashed]-> a2_serviceoperation : aggregation
  a2_businessobject -[#1565C0]-> a2_businessobjectattribute : composition
  a2_controlrecord -[#1565C0]-> a2_behaviorqualifier : composition
  a2_controlrecord -[#9E9E9E,dotted]-> a2_businessobject : association
  a2_serviceoperation -[#616161,dotted]-> a2_controlrecord : access
  a2_servicedomain -[#EF6C00,dashed]-> a2_servicedomain : flow
