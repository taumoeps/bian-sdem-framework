{
  "metamodel_version": "0.4.0",
  "note": "Rules for `sdem transform`: how a Confluence HTML export of past designs becomes candidate architecture records. Rules only — no AI, no network. Copy this file, change the words to match your pages, and pass it with --rules. Matching ignores case, punctuation and extra spaces. Design: docs/sdem-transform-design.md; spec: docs/sdem-transform-spec.md. Any folder layout: pages are found anywhere (HTML, Markdown, text, CSV), folder names act as section headings, diagrams are linked to the page that refers to them, files in the root are kept as provenance.",
  "id_prefix": "HIS-",
  "skip_folders": [
    "styles",
    "images/icons",
    "images/emoticons",
    "__MACOSX"
  ],
  "attachment_folders": [
    "attachments"
  ],
  "container_folders": [
    "archives",
    "archive",
    "attachments",
    "export",
    "pages",
    "html",
    "raw",
    "content",
    "diagrams",
    "images"
  ],
  "manifest_keys": {
    "note": "Column or field names in a JSON or CSV file in the export root that say which page a row is about, and what to take from it. A row is matched to a page when one of its values equals the page file path, file name or title.",
    "page_id": [
      "id",
      "page id",
      "pageid",
      "page_id",
      "content id",
      "confluence id"
    ],
    "url": [
      "url",
      "link",
      "page url",
      "source url",
      "source",
      "web url"
    ],
    "title": [
      "title",
      "page title",
      "page name"
    ],
    "modified": [
      "modified",
      "last modified",
      "last_modified",
      "updated",
      "last updated",
      "date"
    ],
    "space": [
      "space",
      "space key",
      "space name"
    ]
  },
  "max_diagram_bytes": 50000000,
  "confidence": {
    "table": "medium",
    "diagram_shape": "medium",
    "diagram_colour": "low",
    "diagram_label": "low",
    "diagram_line": "low",
    "narrative": "low",
    "table_endpoint": "low",
    "note": "Never high: every record is a candidate until a person confirms it (as AID-B6 caps name-only evidence).",
    "plantuml_typed": "medium",
    "plantuml_untyped": "low",
    "ocr": "low",
    "svg_text": "low"
  },
