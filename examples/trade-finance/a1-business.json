      "attributes": {
        "applies_to": [
          "PRC-LC-APPLY"
        ]
      }
    },
    {
      "id": "REQ-02",
      "type": "A1.BusinessRequirement",
      "version": "1.0",
      "name": "Discrepancies recorded",
      "lifecycle_status": "active",
      "description": "Every document discrepancy found is recorded against the document set.",
      "attributes": {
        "applies_to": [
          "ACT-T3"
        ]
      }
    },
    {
      "id": "REQ-03",
      "type": "A1.BusinessRequirement",
      "version": "1.0",
      "name": "Dual authorisation on issuance",
      "lifecycle_status": "active",
      "description": "Issuance of a letter of credit requires two authorised officers.",
      "attributes": {
        "applies_to": [
          "ACT-T4"
        ]
      }
    },
    {
      "id": "ACTOR-TRADE-OPS",
      "type": "A1.BusinessActor",
