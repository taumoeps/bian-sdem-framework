        "words": "deployed on"
      },
      "DEPLOYED_AS": {
        "line": "realization",
        "arrow": "source",
        "words": "deployed as"
      },
      "MAPPED_TO": {
        "line": "association",
        "arrow": null,
        "words": "mapped to"
      }
    }
  },
