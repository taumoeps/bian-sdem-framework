        "line": "triggering",
        "arrow": "target",
        "words": "triggers"
      },
      "flow": {
        "line": "flow",
        "arrow": "target",
        "words": "flows to"
      },
      "association": {
        "line": "association",
        "arrow": null,
        "words": "associated with"
      },
      "composition": {
        "line": "composition",
        "arrow": null,
        "words": "composed of"
