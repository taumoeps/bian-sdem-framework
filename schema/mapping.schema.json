{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDMM Mapping Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "metamodel_version": {"type": "string", "minLength": 1},
    "engine": {"type": "string", "minLength": 1},
    "mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "source",
        "relationship",
        "target",
        "status",
        "evidence",
        "rationale",
        "baseline_id"
      ],
      "properties": {
        "mapping_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/entity"},
        "target": {"$ref": "#/$defs/entity"},
        "relationship": {"type": "string", "minLength": 1},
        "perspective": {"enum": ["process", "information", "architecture"]},
        "status": {
          "enum": ["proposed", "validated", "needs_review", "approved", "rejected", "superseded"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1},
        "baseline_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bian_release": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "valid_from": {"type": "string", "minLength": 1},
        "valid_to": {"type": "string", "minLength": 1},
        "previous_mapping_id": {"type": "string", "minLength": 1}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "pattern": "^(A[1-4]|L[0-3])\\.[A-Za-z]+$"},
        "version": {"type": "string", "minLength": 1},
        "canonical_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
