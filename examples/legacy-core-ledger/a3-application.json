      "description": "Twenty-year-old core banking ledger: accounts, postings, payments, customer master and nightly batch. SOAP services over HTTP; all operations are POST.",
      "attributes": {
        "vendor": "LedgerMaster Ltd (synthetic)",
        "deployed_on": [
          "INF-MF-LPAR-PROD"
        ],
        "deployed_as": [
          "DEP-LM-PROD"
        ]
      }
    },
