    {
      "id": "IFC-PAYMENT-INITIATION",
      "type": "A3.ApplicationInterface",
      "version": "1",
      "name": "Payment Initiation API v2.3.3",
      "lifecycle_status": "planned",
      "attributes": {
        "security_scheme": "oauth2",
        "protocol": "https",
        "internet_facing": true,
        "field_aliases": {
          "ConsentId": "consent_id",
          "NZDomesticConsent1/InstructionIdentification": "instruction_identification",
          "NZDomesticConsent1/EndToEndIdentification": "end_to_end_identification",
          "NZDomesticConsent1/InstructedAmount/Amount": "amount",
          "NZDomesticConsent1/InstructedAmount/Currency": "currency",
          "Status": "status",
          "DomesticPaymentId": "payment_id"
        },
        "source_id": "document:design.md#5,document:design.md#6"
      },
      "description": "The provider-facing API: domestic payment consents and domestic payments, as the NZ Banking Data standard v2.3.3 defines them."
    },
    {
      "id": "API-CONSENT-CREATE",
      "type": "A3.APIOperation",
      "version": "1",
      "name": "Create domestic payment consent",
      "lifecycle_status": "planned",
      "attributes": {
        "method": "POST",
        "path": "/domestic-payment-consents",
        "payload_fields": [
          "InstructionIdentification",
          "EndToEndIdentification",
          "InstructedAmount/Amount",
          "InstructedAmount/Currency",
          "CreditorAccount/SchemeName",
          "CreditorAccount/Identification",
          "CreditorAccount/Name",
          "DebtorAccount/Identification",
          "DebtorAccountRelease",
          "RemittanceInformation/Reference",
          "ConsentId",
          "Status"
        ],
        "request_fields": [
          "F-CONSENT-INSTRUCTION-IDENTIFICATION",
          "F-CONSENT-END-TO-END-IDENTIFICATION",
          "F-CONSENT-AMOUNT",
          "F-CONSENT-CURRENCY"
        ],
        "response_fields": [
          "F-CONSENT-CONSENT-ID",
          "F-CONSENT-STATUS"
        ],
        "source_id": "document:design.md#5"
      }
    },
    {
      "id": "API-CONSENT-READ",
      "type": "A3.APIOperation",
      "version": "1",
